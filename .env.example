# Supabase public configuration (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets; never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Market data provider (server-only). Quotes are only as real-time as your plan and exchange entitlements.
MARKET_DATA_PROVIDER=mock
TWELVE_DATA_API_KEY=
# Backward-compatible generic provider key; TWELVE_DATA_API_KEY is preferred.
MARKET_DATA_API_KEY=

# Standalone WebSocket worker (mock-only in Phase 1)
MARKET_WS_HOST=127.0.0.1
MARKET_WS_PORT=8787
MARKET_WS_TOKEN=
MARKET_WS_ALLOWED_ORIGIN=http://localhost:3000
MOCK_TICK_INTERVAL_MS=1000
